# ═══════════════════════════════════════════════════════════════
# Academy Manager Pro — cPanel / Passenger (Python 3.11)
# ═══════════════════════════════════════════════════════════════
# این فایل فقط «امنیت + کش استاتیک» است؛ مسیریابی درخواست‌ها را خودِ
# Passenger انجام می‌دهد، پس هیچ RewriteRule به wsgi.py نباید اینجا باشد
# (ریدایرکت قدیمی، روی Passenger حلقه/خطای 404 می‌ساخت).
#
# تنظیمات پیشنهادی در cPanel → Setup Python App:
#   Application root:         public_html/host_deploy
#   Application startup file: passenger_wsgi.py
#   Application Entry point:  application
#   Python version:           3.11
#
# ری‌استارت سریع پس از هر تغییر (بدون ورود به پنل):
#   touch tmp/restart.txt   (از Terminal همان اپلیکیشن)
# ═══════════════════════════════════════════════════════════════

Options -Indexes +FollowSymLinks

# ── امنیت: هیچ‌وقت فایل حساس از طریق HTTP دیده نشود ──────────────
# (اگر Passenger درست پیکربندی شده باشد، این درخواست‌ها اصلاً به Apache
# نمی‌رسند؛ این بلوک برای وقتی است که فایل‌ها مستقیم سرو شوند.)
<FilesMatch "^(settings\.json|config\.ini|\.env|.*\.(db|db-wal|db-shm|db-journal|sqlite3?|log|pem|key|pyc|pyo))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# سورس پایتون نباید از وب خوانده شود (Passenger از روی دیسک می‌خواند، نه HTTP)
<FilesMatch "\.py$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# پوشه‌های داده/سرویس نباید مستقیم باز شوند
RedirectMatch 404 ^/(instance|backups|logs|\.git)(/|$)
RedirectMatch 404 ^/host_deploy_v.*\.zip$

# ── فشرده‌سازی خروجی (بزرگ‌ترین عامل سرعت روی هاست) ──────────────────
# بستهٔ CSS ~۳۷۴KB و بستهٔ JS ~۱۷۰KB است؛ با gzip به ~۵۸KB و ~۴۶KB می‌رسد.
# اگر این ماژول‌ها فعال نباشند، سرویس‌دهندهٔ پایتون خودش فشرده می‌کند
# (bootstrap/static_assets.py)، پس این بلوک فقط «لایهٔ دوم» است.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE text/html text/plain text/xml application/xml
</IfModule>
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/css
    AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml
</IfModule>
# فونت/تصویر از قبل فشرده‌اند؛ DEFLATE رویشان فقط CPU هدر می‌دهد.

# ── کش استاتیک (CSS/JS/فونت/تصویر) ───────────────────────────────
# آدرس همهٔ فایل‌های استاتیک با asset() نسخه‌دار می‌شود (?v=<mtime>-<size>)،
# پس کش یک‌ساله و immutable امن است: با تغییر فایل، آدرسش هم عوض می‌شود.
# استثنا: static/uploads/ که در .htaccess خودش به یک ساعت برگردانده می‌شود.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/json "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    # HTML هرگز کش نشود — دادهٔ مالی کهنه از «کند» بدتر است
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ── هدرهای امنیتی پایه (اگر mod_headers فعال باشد) ────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    <FilesMatch "\.(css|js|mjs|json|webmanifest|woff2?|ttf|png|jpe?g|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
