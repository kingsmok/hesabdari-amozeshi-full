# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.env
.venv
venv/
env/

# SQLite / local DB
instance/*.db
*.sqlite
*.sqlite3

# Backup files (automatically created by system)
backups/
*.backup

# Build / installer artifacts
*.spec
build_installer.bat
installer/
*.iss
build/
dist/
installer_output/
# ...except the maintained build chain (app.spec + setup.iss + build.bat)
!app.spec
!setup.iss

# Installer answers (contains the initial admin password until first launch)
config.ini

# OS files
.DS_Store
Thumbs.db

# Secrets / local config
settings.json
cookies.txt
*.enc

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# License / update artifacts (device-bound, never in VCS)
restart.bat
.update_backup/
