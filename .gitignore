# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.env
.venv
venv/
env/

# SQLite / local DB (فایل‌های کمکی WAL/journal هم داده دارند؛ هرگز commit نشوند)
instance/*.db
instance/*.db-wal
instance/*.db-shm
instance/*.db-journal
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# Backup files (automatically created by system)
backups/
*.backup

# Build / installer artifacts
*.spec
build_installer.bat
installer/
*.iss
build/
dist/
installer_output/
# ...except the maintained build chain (app.spec + setup.iss + build.bat)
!app.spec
!setup.iss

# Installer answers (contains the initial admin password until first launch)
config.ini

# OS files
.DS_Store
Thumbs.db

# Secrets / local config
settings.json
cookies.txt
*.enc

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# License / update artifacts (device-bound, never in VCS)
restart.bat
.update_backup/

# Host deploy staging (generated by deploy_host.bat / deploy_host.py)
host_deploy/
host_deploy_*.zip

# داده محلی و فایل‌های ردیابی‌شده به‌اشتباه در گذشته (اکنون فقط محلی‌اند):
# - instance/academy.db  → دیتابیس واقعی آموزشگاه (داده دانش‌آموز و مالی)
# - cookies.txt          → جاروبِ فایل کوکی نشست
# در نصب تازه، دیتابیس در اولین اجرا ساخته می‌شود (create_all + create_default_data).
!instance/.gitkeep
# مهر زمانیِ نگهداری نشست‌ها (utils/session_maintenance.py — state runtime)
instance/.session_cleanup_stamp
instance/.jalali_repair_stamp

# لاگ و قفل پوسته دسکتاپ (logs/desktop-*.log، single-instance.lock)
logs/
